def click(thumb_x,thumb_y,index_finger_x,index_finger_y,last_thumb_index_distance): #index and thumb together
    global clicked
    
    dist = math.sqrt((thumb_x-index_finger_x)**2 + (thumb_y-index_finger_y)**2)
    delta_dist = dist-last_thumb_index_distance
    #print(dist)
    if delta_dist >0.01:
        if dist <0.2 and not clicked:    #tune
            pyautogui.mouseDown()
            clicked = True
            
        elif dist > 0.3 and clicked:
            pyautogui.mouseUp()
            clicked = False
    #print(clicked)

def move_mouse(average_x,average_y,last_average_x,last_average_y,index_finger_x,index_finger_y): #move hand
    global xSize,ySize
    
    xPos = int(xSize-(xSize * average_x))#pyautogui uses left to right not right to left for x
    yPos = int(ySize * average_y)

    if abs(average_x -last_average_x) >0.015 and abs(average_y -last_average_y) >0.015: 
        
        pyautogui.moveTo(xPos, yPos) #not asynchronous but prevents "skipping" of the cursor, there may be better asynchronous way that doesn't slow down loop
    
    return(index_finger_x,index_finger_y)
    
    
def scroll(thumb_y,last_thumb_y,average_x,last_average_x): 
    global xSize, ySize
    
    deltaYPos = thumb_y - last_thumb_y
    
    deltaAverageX = average_x-last_average_x

    scroll_amount = int((deltaYPos*ySize)*5)
    
    if abs(deltaAverageX) <0.02 and abs(deltaYPos) > 0.07: #tune
        pyautogui.scroll(scroll_amount) #tune for optimal scrolling effectiveness
        
def switchTab(index_finger_x,index_finger_y,thumb_x,thumb_y,last_thumb_index_distance,average_x, last_average_x): #open hand fast to switch tabs
    dist = math.sqrt((thumb_x-index_finger_x)**2 + (thumb_y-index_finger_y)**2)
    deltaDist = dist-last_thumb_index_distance
    deltaAverageX = abs( average_x - last_average_x)
         
    if deltaDist > 0.8 and dist >0.5: #open and opening hand, not moving side to side much
        pyautogui.keyDown('alt')
        pyautogui.press('tab')
        pyautogui.keyUp('alt')
    
    last_thumb_index_distance = dist
    return(last_thumb_index_distance)

