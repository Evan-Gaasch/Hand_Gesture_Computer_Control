def landmark_pos(hand_landmarks):
    if hand_landmarks:
        hand = hand_landmarks[0]
        #print(hand)
    else:
        print("missing")

        #index (all numbers taken from documentation)
    index_tip = hand[8]
        #thumb
    thumb_tip = hand[4]
        #middle
    middle_tip = hand[12]
        #ring
    ring_tip = hand[16]
        #pinky
    pinky_tip = hand[20]

    ring_pip = hand[14]
    
    #average x and y for mouse pointer
    average_x = (thumb_tip.x + index_tip.x + middle_tip.x+ring_tip.x+pinky_tip.x)/5
    average_y = (thumb_tip.y + index_tip.y + middle_tip.y+ring_tip.y+pinky_tip.y)/5
    
    return(index_tip,thumb_tip, middle_tip,ring_tip,pinky_tip,ring_pip,average_x,average_y)
         
def interact(thumb_x,thumb_y,ring_pip_x,ring_pip_y): #fist -> e in game mode
    global interacted
    dist = math.sqrt((thumb_x-ring_pip_x)**2 + (thumb_y-ring_pip_y)**2) #compute distance between index finger and ring finger middle, when it is low it can "only" be because of someone making a fist
    if dist <0.02 and not interacted: #tune
        pyautogui.keyDown('e')
        interacted = True
            
    elif dist >0.03 and interacted:
        pyautogui.keyUp('e')
        interacted = False

